# Private settings for the repository manual scripts. Copy to .env; do not
# commit the result. Library API callers configure OCR and LLMs explicitly.

# OCR mode: deepseek-ocr-local, deepseek-ocr2-local, unlimited-ocr-local,
# deepseek-ocr-vendor, deepseek-ocr2-vendor, unlimited-ocr-vendor.
PDF_CRAFT_OCR_MODE=deepseek-ocr-local

# DeepSeek OCR local. Used only on a CUDA-capable machine.
PDF_CRAFT_DEEPSEEK_OCR_LOCAL_MODELS_CACHE_PATH=./models-cache
PDF_CRAFT_DEEPSEEK_OCR_LOCAL_ONLY=true
# Optional comma-separated CUDA device indexes, for example: 0,1
PDF_CRAFT_DEEPSEEK_OCR_LOCAL_ENABLE_DEVICES_NUMBERS=

# DeepSeek OCR 2 local. Keep this independent from DeepSeek OCR local.
PDF_CRAFT_DEEPSEEK_OCR2_LOCAL_MODELS_CACHE_PATH=./models-cache
PDF_CRAFT_DEEPSEEK_OCR2_LOCAL_ONLY=true
PDF_CRAFT_DEEPSEEK_OCR2_LOCAL_ENABLE_DEVICES_NUMBERS=

# Unlimited OCR local. Keep this independent from the DeepSeek local backends.
PDF_CRAFT_UNLIMITED_OCR_LOCAL_MODELS_CACHE_PATH=./models-cache
PDF_CRAFT_UNLIMITED_OCR_LOCAL_ONLY=true
PDF_CRAFT_UNLIMITED_OCR_LOCAL_ENABLE_DEVICES_NUMBERS=

# DeepSeek OCR vendor.
PDF_CRAFT_DEEPSEEK_OCR_BASE_URL=
PDF_CRAFT_DEEPSEEK_OCR_API_KEY=
PDF_CRAFT_DEEPSEEK_OCR_MODEL=deepseek-ocr
PDF_CRAFT_DEEPSEEK_OCR_TEMPERATURE=0.0
PDF_CRAFT_DEEPSEEK_OCR_TOP_P=0.7
PDF_CRAFT_DEEPSEEK_OCR_MAX_TOKENS=8000
PDF_CRAFT_DEEPSEEK_OCR_TIMEOUT_SECONDS=180

# DeepSeek OCR 2 vendor.
PDF_CRAFT_DEEPSEEK_OCR2_BASE_URL=
PDF_CRAFT_DEEPSEEK_OCR2_API_KEY=
PDF_CRAFT_DEEPSEEK_OCR2_MODEL=
PDF_CRAFT_DEEPSEEK_OCR2_TEMPERATURE=0.0
PDF_CRAFT_DEEPSEEK_OCR2_TOP_P=0.7
PDF_CRAFT_DEEPSEEK_OCR2_MAX_TOKENS=8000
PDF_CRAFT_DEEPSEEK_OCR2_TIMEOUT_SECONDS=180

# Unlimited OCR vendor.
PDF_CRAFT_UNLIMITED_OCR_ACCESS_KEY=
PDF_CRAFT_UNLIMITED_OCR_SECRET_KEY=
PDF_CRAFT_UNLIMITED_OCR_BASE_URL=https://aip.baidubce.com
PDF_CRAFT_UNLIMITED_OCR_POLL_INTERVAL_SECONDS=2
PDF_CRAFT_UNLIMITED_OCR_TIMEOUT_SECONDS=180

# Named text-LLM profiles for pdf_craft_tool. Profiles may be reused by TOC,
# translation and XML fill, or configured independently. "oomol" reads a
# short-lived connection from `oo llm config --json`; never put its API key here.
PDF_CRAFT_LLM_DEFAULT_PROVIDER=oomol
PDF_CRAFT_LLM_DEFAULT_TOKEN_ENCODING=o200k_base
PDF_CRAFT_LLM_DEFAULT_TIMEOUT_SECONDS=180
PDF_CRAFT_LLM_DEFAULT_TEMPERATURE=0.0
PDF_CRAFT_LLM_DEFAULT_TOP_P=0.7
PDF_CRAFT_LLM_DEFAULT_RETRY_TIMES=3

# Purpose defaults. Override a profile's *_PROFILE value to point at another
# named profile. By default each purpose reuses the DEFAULT profile.
PDF_CRAFT_LLM_TOC_PROFILE=default
PDF_CRAFT_LLM_TRANSLATION_PROFILE=default
PDF_CRAFT_LLM_FILL_PROFILE=default

# Example custom OpenAI-compatible profile named "premium":
# PDF_CRAFT_LLM_PREMIUM_PROVIDER=openai
# PDF_CRAFT_LLM_PREMIUM_BASE_URL=
# PDF_CRAFT_LLM_PREMIUM_API_KEY=
# PDF_CRAFT_LLM_PREMIUM_MODEL=
