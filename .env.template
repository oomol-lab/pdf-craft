# Local development defaults.
#
# Copy this file to .env for machine-specific values. The package does not
# automatically read this file; manual scripts may load it when they need OCR
# settings.

# PDF_CRAFT_OCR_MODE:
# - local-deepseek: local DeepSeek-OCR model, requires CUDA for real conversion
# - vendor-deepseek: DeepSeek OCR through an OpenAI-compatible endpoint
# - vendor-unlimited: Baidu Unlimited OCR
PDF_CRAFT_OCR_MODE=local-deepseek

# Local DeepSeek OCR.
PDF_CRAFT_MODELS_CACHE_PATH=./models-cache
PDF_CRAFT_LOCAL_ONLY=false

# Vendor DeepSeek OCR.
PDF_CRAFT_DEEPSEEK_BASE_URL=
PDF_CRAFT_DEEPSEEK_API_KEY=
PDF_CRAFT_DEEPSEEK_MODEL=deepseek-ocr
PDF_CRAFT_DEEPSEEK_TEMPERATURE=0.0
PDF_CRAFT_DEEPSEEK_TOP_P=0.7
PDF_CRAFT_DEEPSEEK_MAX_TOKENS=8000
PDF_CRAFT_DEEPSEEK_TIMEOUT_SECONDS=180

# Vendor Unlimited OCR.
PDF_CRAFT_UNLIMITED_AK=
PDF_CRAFT_UNLIMITED_SK=
PDF_CRAFT_UNLIMITED_BASE_URL=https://aip.baidubce.com
PDF_CRAFT_UNLIMITED_POLL_INTERVAL_SECONDS=2
PDF_CRAFT_UNLIMITED_TIMEOUT_SECONDS=180
