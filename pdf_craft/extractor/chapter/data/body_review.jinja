{# JEV provider-input text. Macros return JSON values; Python owns selection and aggregation. #}

{% macro closed_quoted_frame_instruction() -%}
"Judge whether the LEFT reporting/quoted frame is complete, not whether the current OCR opening is grammatical. Missing characters at the target opening do not create an unclosed left clause. Preserve any actual outer conditional or obligatory complement in the left text; never invent one to repair an OCR fragment."
{%- endmacro %}

{% macro closed_predecessor_frame(label) -%}
{
"type": "noul",
"instructions": [
"Judge only checks.{{ (label | string | tojson)[1:-1] }}. Is the LEFT selected_predecessor already a complete grammatical frame, so the target does not supply any obligatory missing clause or complement to it?",
"Locate the exact left source in local_raw_evidence by page_index and source_order. Evaluate what that LEFT text requires, not whether the target looks like a complete sentence. A standalone description, screenplay shot or displayed variable-definition row may start its own paragraph after a complete left frame. Shared topic or the conjunction and does not itself create an unfinished left construction.",
"Do not certify a left conditional still requiring its main clause, an incomplete verb/preposition or missing obligatory complement. A semicolon, period or formula alone does not close an actual unfinished surrounding frame. Do not invent missing OCR text or an earlier convenient predecessor. If the left frame is not demonstrably closed, answer FALSE."
],
"criteria": {
"true": "The exact left frame is closed; the target does not complete an obligatory construction.",
"false": "An unfinished left construction remains or closure cannot be established."
}
}
{%- endmacro %}

{% macro closed_predecessor_main_reading(role) -%}
{
"type": "noul",
"instructions": [
"Judge only checks.{{ (role | string | tojson)[1:-1] }}. Is the exact selected_predecessor genuinely in the main reading stream, rather than a detached footnote, caption or publisher apparatus that happens to have been misclassified?",
"Read its complete raw source and all local sources on that page, including neighboring note markers, smaller-print regions and continuations. A footnote can have several paragraphs, quotations and a long unmarked final block. Do not accept the last supplied paragraph as main reading merely because it is grammatical. Conversely autonomous commentary sections and ordinary narrative are main reading. Require positive role evidence; ambiguity means FALSE.",
"This question only verifies whether this particular source can certify a new main-paragraph break. It does not select or invent a different, earlier predecessor."
],
"criteria": {
"true": "The exact source is genuine main reading.",
"false": "It belongs to an ancillary stream, or its main-reading role is not established."
}
}
{%- endmacro %}

{% macro nonreading_page_trace(key) -%}
{
"type": "noul",
"instructions": [
"Judge only checks.{{ (key | string | tojson)[1:-1] }}. Is this retained punctuation-only source a non-reading scan/OCR trace on a page without textual reading content, rather than an intentional reading unit?",
"Use all raw target layouts, literal source text and its normalized box. A tiny punctuation trace represented by an almost whole-page OCR text rectangle, on an otherwise text-empty page, can be noise; it must not be joined to main prose on a neighboring page. The large rectangle is not evidence of a large printed character.",
"Punctuation alone does not prove noise. Preserve actual dialogue punctuation, intentional poem/section separators, standalone mathematical notation and signs that have a concrete reading role. Do not invent image pixels or absent text. Require positive evidence of a non-reading artifact; ambiguity means FALSE."
],
"criteria": {
"true": "The source is a non-reading page trace kept as prose.",
"false": "That artifact role is not established."
}
}
{%- endmacro %}

{% macro publisher_apparatus(key) -%}
{
"type": "noul",
"instructions": [
"Judge only checks.{{ (key | string | tojson)[1:-1] }}. Is this exact source a printed page number, running header/footer or repeated publisher/navigation label, incorrectly kept in the main reading stream?",
"Use its literal text, page-edge geometry and the surrounding original sources. A combined page number plus chapter/book label at the outer margin can be one apparatus block, including on an otherwise blank page. An empty page does not turn its footer into body text.",
"Require positive evidence of a publisher/navigation role. Page-edge position, short length, digits or a personal name alone are insufficient. Preserve real chapter openings, section headings, author attributions, dialogue, numbered exercises, endnotes/footnotes and short narrative paragraphs. A heading may start low on a page and remain real content. Do not infer missing text or a fourth page. Ambiguous evidence means FALSE."
],
"criteria": {
"true": "The exact source is page apparatus, not main reading content.",
"false": "A publisher/navigation role is not established."
}
}
{%- endmacro %}

{% macro same_example_setup(key) -%}
{
"type": "noul",
"instructions": [
"Assess only checks.{{ (key | string | tojson)[1:-1] }}. Does the actual selected predecessor introduce ONE mathematical example whose immediate specification is the target opening, so keeping them in one paragraph is permissible?",
"A short example introduction and its immediately following Let/Suppose specification may remain in one paragraph even if the introduction ends with a period. Do not require a forced split merely because both pieces have punctuation. Require a direct introduction-to-specification relation, not just related mathematics. A new numbered example, independent exercise, heading or change of task cannot use this proof. Use the actual nearest predecessor, not a more distant convenient one. No unprovided indentation or image text may be invented."
],
"criteria": {
"true": "This existing join keeps one directly introduced example and its specification together.",
"false": "That direct same-example relationship is not established."
}
}
{%- endmacro %}

{% macro numbered_instruction_questions() -%}
[
[
"one_numbered_instruction",
"Do the selected predecessor condition and the target command belong to ONE explicitly numbered exercise instruction, with no new numbered item, heading or independent task starting at the target?"
],
[
"conditional_command_required",
"Does the target command supply the actual required main instruction governed by the unfinished If-condition ending in a comma in selected_predecessor, so the proposed break cuts one grammatical exercise instruction?"
]
]
{%- endmacro %}

{% macro numbered_instruction(key, ask) -%}
{
"type": "noul",
"instructions": [
"Judge only checks.{{ (key | string | tojson)[1:-1] }}. Use the exact selected_predecessor and current target in local_raw_evidence.",
{{ ask | tojson }},
"Confirm the literal numbered condition and its immediate command, not merely a shared mathematical topic. A completed example followed by a new problem, independently displayed alternative transformation rows, or an intervening standalone formula cannot establish this fault. Do not invent omitted words or impose paragraph-style preferences. If the target is a distinct item or that grammatical dependency is not established, answer FALSE."
],
"criteria": {
"true": "This specific literal relationship is established.",
"false": "That specific relationship is not established."
}
}
{%- endmacro %}

{% macro illustration_roles() -%}
[
[
"prior_illustration_unit",
"Is the selected predecessor printed as a separate text band associated with the large nearby illustration, such as a caption or credited literary excerpt, instead of being a normal running-text paragraph?",
"The selected source has a concrete independent illustration-associated role.",
"That independent illustration role is not established."
],
[
"target_leaves_illustration",
"Is the CURRENT target source ordinary main reading on its page, rather than part of an illustration caption or detached image/excerpt strip? Judge only its printed role, not whether it starts a complete word or sentence. A main prose fragment can continue earlier body text that is outside this three-page window; you need not find or invent that earlier body text to establish the target role. Related or repeated story wording does not make two sources the same printed unit.",
"The target source belongs to ordinary main reading, not to the predecessor illustration caption/excerpt stream.",
"The main-reading role outside the illustration caption/excerpt stream is not established."
]
]
{%- endmacro %}

{% macro illustration_join(key, ask, yes, no) -%}
{
"type": "noul",
"instructions": [
"Audit ONLY state.checks.{{ (key | string | tojson)[1:-1] }}. The selected_predecessor identifies the concrete source that this proposed incoming JOIN attaches to. Judge that source and current target, not some older passage chosen because its wording fits.",
{{ ask | tojson }},
"measured_adjacency reports literal box measurements, not a role verdict. A literary passage can be an image caption even when its wording is ordinary narrative copied from the book. If a narrow text strip directly below the large image ends with a photo credit, evaluate the function of the WHOLE strip; do not label its prose ordinary narrative merely because the same story occurs elsewhere. Conversely a nearby small illustration or a personal name alone cannot establish a separate caption unit.",
"Use complete local_raw_evidence, the selected source text and the supplied image positions. Image presence alone, a credit name alone, repeated wording alone, or related subject matter is not proof. A passage quoted from ordinary prose can be a separate printed unit with an illustration. Conversely running prose can flow past an image, and captions can continue across pages. Do not infer missing print, unprovided indentation or a fourth page. Ambiguous evidence means FALSE."
],
"criteria": {
"true": {{ yes | tojson }},
"false": {{ no | tojson }}
}
}
{%- endmacro %}

{% macro join_rules() -%}
{
"instructions": [
"只用提供的局部原始文字判断两个块是否构成同一自然段。不是审核整页，不评价邻页自己的字段。",
"一个词语或语法结构被分到两个块时应连接。明确新的独立发言、标题或编号条目应另起。不因为主题相同、问答或句号机械决定。",
"不校对文字，不补足未提供的OCR缺字，不假设远处内容。当前块很长时不要忽略其开头与前块末尾的直接接缝。",
"当present_decision=false时，必须找到前块未完成的词语或不可独立的句法成分由当前块直接补足，才判该字段错误；两个已经完整的表达分成两段是合法的。并且、因此、转折和相同话题均不强迫合段。",
"引出引文的段落与后面的独立引文可以分段；引文后的作者署名、出处也可以独立成段。冒号和出处依附关系不是必须合段的证据。",
"只判现有入向决定是否有确定的结构错误。不能从整框位置猜测没有提供的首行缩进，也不以自己的排版喜好强制拆段或合段。"
],
"conditional": "当前字段为续接：先组合前块末尾和当前开头的一两个字检查完整词语。词语的前后两部分恰好被跨页分开，保持续接就是正确的，不能被当前块后续的其他完整句误导。",
"criteria": {
"true": "当前块确为前块所属自然段的续文，本次续接是合法的。",
"false": "当前块必须另起自然段，现有续接把两个独立段落错误合并。"
}
}
{%- endmacro %}

{% macro ownership_standard() -%}
[
"paragraph 是正文、标题、引文等主阅读流；页码、running header 和装饰物不应进入此流。",
"关闭脚注指最终不输出脚注，不代表 OCR 原分类必然正确；不建立 citation 或引用体系。",
"原 footnote 来源候选默认 ignored；若有明确证据属于正文或跨页正文续文，应判为需要修正以恢复 paragraph。",
"原 body 中有明确证据属于脚注的完整块应 ignored，否则需要修正；不能仅凭页底、小字号或数字开头判为脚注。",
"同时包含正文与脚注的块不能整块忽略；不确定时保留初级归属，不要求删除正文或重建缺失文字。",
"必须逐块检查全部脚注范围，包括不带编号的后续解释、图式及跨页续文；只排除编号开头而保留无编号续段仍是错误。相邻初级页也可能误分类，不应据此放行。",
"转下页/接上页及独立页码不是正文。正文跨页连接应跳过这些出版提示和脚注，不能把它们接到真实正文。",
"成页或章末校释是主阅读内容，属于paragraph；页底附属于正文引用的注释才属于脚注。不能仅因编号或释义体裁就排除成页校释。",
"关闭脚注时，正文中遗留①、上标数字、星号等原始引用字符完全合法；没有相应citation/ref也合法。只有实际把注释解释文字混入正文才是归属错误。"
]
{%- endmacro %}

{% macro incoming_join(key, _JOIN_RULES) -%}
{
"type": "noul",
"instructions": [
"此题只审核checks.{{ (key | string | tojson)[1:-1] }}的现有操作：将当前块续接到前面的正文，作为同一自然段。完整三页证据在local_raw_evidence。",
"先在preceding_source_candidates对应的preceding_source_index中寻找真实正文前驱，再审核当前入向。ownership_hint和immediate_paragraph_hint不是事实，原OCR/算法可能把脚注排成paragraph；不能只拿数组最后一项与当前块比较。",
"若最近一项是注释、页码或页眉，应跳过它，核对前面的真实正文候选。只判断当前页的入向，不因邻页自己的归属错误单独否决本题。不得使用三页以外的内容，也不得把next_page作为入向前驱。",
"真实正文前驱必须是排除附属物后距离当前最近的正文。不能跳过中间一块真实正文去挑更早、看起来能接的语句；候选不是可任意拼接的语料库。若最近正文已经完整结束，当前块独立另起是合法的，即使叙述同一事件。",
{% for item in _JOIN_RULES['instructions'] %}{{ item | tojson }}, {% endfor %}
{{ _JOIN_RULES['conditional'] | tojson }}
],
"criteria": {{ _JOIN_RULES['criteria'] | tojson }}
}
{%- endmacro %}

{% macro concrete_join_instructions(key, _JOIN_RULES) -%}
[
"只审核 checks.{{ (key | string | tojson)[1:-1] }} 这个实际入向：当前块已经与 selected_predecessor 指定的具体来源归为同一自然段。必须审核实际被拼接的来源，不是清理邻页后理想上应该拼接的正文。",
"selected_predecessor 的原文在 local_raw_evidence 中，page_index 和 source_order 唯一定位。ownership_hint 不是正确性证据，但明确表示本次算法实际选择了它。若它实际是脚注、图片题注或出版附属物，不可假装跳过它再选择更早的正文来批准这个实际入向。",
"仍需区分：邻页本身的独立归属错误不必否决当前页；但当前入向把两个不同的印刷阅读单元确实拼成同一自然段，是当前入向自身的错误。两个本来连续的脚注/引文片段可以相接。只因内容相近或词语巧合而连接不同单元不合法。",
{% for item in _JOIN_RULES['instructions'] %}{{ item | tojson }}, {% endfor %}
{{ _JOIN_RULES['conditional'] | tojson }}
]
{%- endmacro %}

{% macro kept_reading_meaning() -%}
"保留为主阅读流paragraph"
{%- endmacro %}

{% macro kept_reading_criteria() -%}
{
"true": "当前块属于正文、标题、引文或独立校释等主阅读内容，保留是合法的。",
"false": "当前块明确属于应排除的脚注、页眉页码等，却被保留在主阅读流。"
}
{%- endmacro %}

{% macro excluded_reading_criteria() -%}
{
"true": "当前块应被排除，或没有充分证据恢复为主阅读内容；现有排除可接受。",
"false": "当前块明确属于正文、标题、引文或独立校释，却被错误排除。"
}
{%- endmacro %}

{% macro ownership(order, meaning, key, _OWNERSHIP_STANDARD, criteria) -%}
{
"type": "noul",
"instructions": [
"此题只审核target_page中source_order={{ (order | string | tojson)[1:-1] }}的现有操作：{{ (meaning | string | tojson)[1:-1] }}，位置索引为checks.{{ (key | string | tojson)[1:-1] }}。只审这一块归属，不审其他块或自然段入向。",
"本次关闭脚注提取，不要求建立citation、脚注编号匹配或正文ref。原OCR分类、算法ownership都不是正确答案。",
{% for item in _OWNERSHIP_STANDARD %}{{ item | tojson }}, {% endfor %}
"完整三页证据在local_raw_evidence。依据原文、已有标记和几何联合定位，不假设未提供的图像分隔线或文字。不要把别块的错误判给此块。清楚可修复的归属错误才FAIL，作者措辞、OCR错字或单纯不确定不是归属错误。"
],
"criteria": {{ criteria | tojson }}
}
{%- endmacro %}

{% macro excluded_reading_meaning() -%}
"排除为ignored"
{%- endmacro %}
